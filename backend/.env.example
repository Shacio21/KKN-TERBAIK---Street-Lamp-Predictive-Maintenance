APP_NAME="PJU IoT Monitoring API"
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+asyncpg://pju:pju@postgres:5432/pju_monitoring
REDIS_URL=redis://redis:6379/0
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=pju_backend
MQTT_PASSWORD=mqtt_secret
MQTT_BASE_TOPIC=pju/#
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FIRST_ADMIN_EMAIL=admin@pju.local
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrator
UPLOAD_DIR=uploads

# SMTP (optional, emails logged to console if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=noreply@pju-monitor.id
# SMTP_FROM_NAME=PJU Monitor

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
